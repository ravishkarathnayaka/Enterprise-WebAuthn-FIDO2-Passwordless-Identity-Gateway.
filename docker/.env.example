# Relying Party (RP) Settings
RP_ID=localhost
RP_NAME=Enterprise WebAuthn Gateway
EXPECTED_ORIGIN=http://localhost:8000,https://localhost:8000,http://localhost:8443,https://localhost:8443

# Security & Secrets
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-string-at-least-32-chars
CHALLENGE_TIMEOUT_SECONDS=120
STEP_UP_MAX_AGE_SECONDS=60
SESSION_EXPIRATION_MINUTES=60

# Infrastructure
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
REDIS_URL=redis://redis:6379/0
UPSTREAM_URL=http://upstream:8001
